rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/equipes/$(teamId)/membros/$(request.auth.uid));
    }

    function isTeamAdmin(teamId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/equipes/$(teamId)/membros/$(request.auth.uid)).data.role == "admin";
    }

    function hasAcceptedTeamInvite(teamId, userId) {
      return isSignedIn()
        && getAfter(/databases/$(database)/documents/convitesEquipe/$(teamId + "_" + userId)).data.convidadoId == userId
        && getAfter(/databases/$(database)/documents/convitesEquipe/$(teamId + "_" + userId)).data.equipeId == teamId
        && getAfter(/databases/$(database)/documents/convitesEquipe/$(teamId + "_" + userId)).data.status == "aceito";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCandidaturaParticipant() {
      return isSignedIn()
        && (
          resource.data.empresaId == request.auth.uid
          || resource.data.freelancerId == request.auth.uid
        );
    }

    function isValidUserProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'nome',
          'email',
          'tipo',
          'uidUsuario',
          'fotoURL',
          'logoURL',
          'linkedin',
          'github',
          'criadoEm',
          'atualizadoEm',
          'bio',
          'habilidades',
          'areaAtuacao',
          'disponibilidade',
          'descricaoInstitucional',
          'localizacao',
          'site'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.tipo in ['freelancer', 'empresa']
        && request.resource.data.criadoEm == request.time
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
    }

    function isValidUserProfileUpdate(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome',
          'email',
          'uidUsuario',
          'fotoURL',
          'logoURL',
          'linkedin',
          'github',
          'atualizadoEm',
          'bio',
          'habilidades',
          'areaAtuacao',
          'disponibilidade',
          'descricaoInstitucional',
          'localizacao',
          'site'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.criadoEm == resource.data.criadoEm
        && (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid);
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow create: if isValidUserProfileCreate(userId);
      allow update: if isValidUserProfileUpdate(userId);
      allow delete: if false;
    }

    match /amizades/{amizadeId} {
      allow read: if isSignedIn() && (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userA == request.auth.uid
        && request.resource.data.userA != request.resource.data.userB
        && request.resource.data.status == "pendente";

      allow update: if isSignedIn()
        && resource.data.status == "pendente"
        && request.resource.data.status == "aceita"
        && request.resource.data.userA == resource.data.userA
        && request.resource.data.userB == resource.data.userB
        && request.auth.uid == resource.data.userB;

      allow delete: if false;
    }

    match /problemas/{problemaId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.empresaId == request.auth.uid;

      allow update, delete: if isSignedIn()
        && resource.data.empresaId == request.auth.uid;

      match /comentarios/{comentarioId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == "freelancer"
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.autorNome is string
          && request.resource.data.autorNome.size() > 0
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 500;
        allow update, delete: if isSignedIn()
          && resource.data.autorId == request.auth.uid;
      }
    }

    match /candidaturas/{candidaturaId} {
      allow read: if isSignedIn()
        && (resource.data.empresaId == request.auth.uid || resource.data.freelancerId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.freelancerId == request.auth.uid
        && request.resource.data.empresaId != request.auth.uid
        && request.resource.data.status == "pendente"
        && request.resource.data.problemaId is string
        && request.resource.data.empresaId is string
        && request.resource.data.freelancerId is string;

      allow update: if isCandidaturaParticipant()
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.freelancerId == resource.data.freelancerId
        && request.resource.data.problemaId == resource.data.problemaId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "chatId"])
        && request.resource.data.status in ["pendente", "aceito", "recusado", "concluido", "cancelado"];

      allow delete: if false;
    }

    match /equipes/{equipeId} {
      allow create: if isSignedIn() && request.resource.data.criadorId == request.auth.uid;
      allow read: if isTeamMember(equipeId);
      allow update, delete: if isTeamAdmin(equipeId);

      match /membros/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isTeamMember(equipeId));

        allow create: if isTeamAdmin(equipeId)
          || (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.role == "membro"
            && hasAcceptedTeamInvite(equipeId, userId))
          || (isSignedIn()
            && request.auth.uid == userId
            && getAfter(/databases/$(database)/documents/equipes/$(equipeId)).data.criadorId == request.auth.uid
            && request.resource.data.role == "admin");

        allow update: if isTeamAdmin(equipeId)
          && userId != get(/databases/$(database)/documents/equipes/$(equipeId)).data.criadorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
          && request.resource.data.role in ["admin", "membro"];
        allow delete: if isTeamAdmin(equipeId)
          || (isSignedIn()
            && request.auth.uid == userId
            && get(/databases/$(database)/documents/equipes/$(equipeId)/membros/$(userId)).data.role != "admin");
      }
    }

    match /convitesEquipe/{conviteId} {
      allow read: if isSignedIn()
        && (resource.data.convidadoId == request.auth.uid
          || isTeamAdmin(resource.data.equipeId));

      allow create: if isTeamAdmin(request.resource.data.equipeId)
        && request.resource.data.convidadoPorId == request.auth.uid
        && request.resource.data.convidadoId != request.auth.uid
        && request.resource.data.status == "pendente";

      allow update: if isSignedIn()
        && resource.data.convidadoId == request.auth.uid
        && resource.data.status == "pendente"
        && request.resource.data.convidadoId == resource.data.convidadoId
        && request.resource.data.convidadoPorId == resource.data.convidadoPorId
        && request.resource.data.equipeId == resource.data.equipeId
        && request.resource.data.status in ["aceito", "recusado"];

      allow delete: if isTeamAdmin(resource.data.equipeId);
    }

    match /chats/{chatId} {
      allow read, update: if isSignedIn()
        && (resource.data.empresaId == request.auth.uid || resource.data.freelancerId == request.auth.uid);

      allow create: if isSignedIn()
        && (request.resource.data.empresaId == request.auth.uid || request.resource.data.freelancerId == request.auth.uid);

      match /mensagens/{mensagemId} {
        allow read, create: if isSignedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.empresaId == request.auth.uid
            || get(/databases/$(database)/documents/chats/$(chatId)).data.freelancerId == request.auth.uid);
      }

      match /propostas/{propostaId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.empresaId == request.auth.uid
            || get(/databases/$(database)/documents/chats/$(chatId)).data.freelancerId == request.auth.uid);
        allow create: if isSignedIn()
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.valor is number
          && request.resource.data.valor > 0
          && request.resource.data.status == "pendente"
          && get(/databases/$(database)/documents/chats/$(chatId)).data.acordo == null
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.empresaId == request.auth.uid
            || get(/databases/$(database)/documents/chats/$(chatId)).data.freelancerId == request.auth.uid);
        allow update: if isSignedIn()
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.empresaId == request.auth.uid
            || get(/databases/$(database)/documents/chats/$(chatId)).data.freelancerId == request.auth.uid)
          && request.auth.uid != resource.data.autorId
          && resource.data.status == "pendente"
          && request.resource.data.status == "aceita"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "aceitaEm", "aceitaPor"]);
      }
    }

    match /chatsAmizade/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /mensagens/{mensagemId} {
        allow read, create: if isSignedIn()
          && exists(/databases/$(database)/documents/chatsAmizade/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chatsAmizade/$(chatId)).data.participants;
      }
    }

    match /chatsEquipe/{chatId} {
      allow read: if isTeamMember(chatId);
      allow update: if isTeamMember(chatId)
        && request.resource.data.equipeId == resource.data.equipeId
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "equipeNome",
          "participants",
          "ultimaMensagem",
          "ultimaMensagemAutorId",
          "ultimaMensagemEm",
          "ultimoAcessoPor"
        ])
        && ((request.resource.data.participants == resource.data.participants) || isTeamAdmin(chatId));
      allow delete: if isTeamAdmin(chatId);

      allow create: if isSignedIn()
        && request.resource.data.equipeId == chatId
        && isTeamMember(chatId);

      match /mensagens/{mensagemId} {
        allow read: if isTeamMember(chatId);
        allow create: if isTeamMember(chatId);
        allow delete: if isTeamAdmin(chatId);
      }
    }
  }
}
